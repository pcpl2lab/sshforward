{"version": 2, "width": 100, "height": 35, "timestamp": 1711500000, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "sshforward — Troubleshooting & Error Handling"}
[0.0, "o", "\u001b[1;34m$\u001b[0m "]
[0.5, "o", "# Typo detection in config"]
[1.2, "o", "\r\n"]
[1.4, "o", "\u001b[1;34m$\u001b[0m "]
[2.2, "o", "sshforward start myserver mysql"]
[2.9, "o", "\r\n"]
[3.1, "o", "\u001b[31mError:\u001b[0m service \"mysql\" line 3: unknown field \"localport\" (did you mean \"local_port\"?)\r\n"]
[4.5, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[5.3, "o", "# Unknown host validation"]
[6.0, "o", "\r\n"]
[6.2, "o", "\u001b[1;34m$\u001b[0m "]
[7.0, "o", "sshforward start unknown-host mysql"]
[7.7, "o", "\r\n"]
[7.9, "o", "\u001b[31mError:\u001b[0m host \"unknown-host\" not found in ~/.ssh/config. Available hosts: myserver, staging, prod\r\n"]
[9.5, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[10.3, "o", "# Viewing SSH logs for dead tunnels"]
[11.0, "o", "\r\n"]
[11.2, "o", "\u001b[1;34m$\u001b[0m "]
[12.0, "o", "sshforward logs myserver mysql"]
[12.7, "o", "\r\n"]
[12.9, "o", "--- myserver/mysql (PID: 48052, DEAD) ---\r\n"]
[12.9, "o", "ssh: connect to host 192.168.1.100 port 22: Connection timed out\r\n"]
[14.5, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[15.3, "o", "# Stop all tunnels at once"]
[16.0, "o", "\r\n"]
[16.2, "o", "\u001b[1;34m$\u001b[0m "]
[17.0, "o", "sshforward stop --all"]
[17.7, "o", "\r\n"]
[17.9, "o", "Stopped 3 tunnel(s)\r\n"]
[19.0, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[20.0, "o", ""]
