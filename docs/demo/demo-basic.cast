{"version": 2, "width": 100, "height": 30, "timestamp": 1711500000, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "sshforward — Basic Usage"}
[0.0, "o", "\u001b[1;34m$\u001b[0m "]
[0.8, "o", "cat ~/.sshforward/config.yaml"]
[1.4, "o", "\r\n"]
[1.5, "o", "\u001b[33mservices:\u001b[0m\r\n"]
[1.5, "o", "  \u001b[33mmysql:\u001b[0m\r\n"]
[1.5, "o", "    \u001b[36mremote_port:\u001b[0m 3306\r\n"]
[1.5, "o", "\r\n"]
[1.5, "o", "  \u001b[33mredis:\u001b[0m\r\n"]
[1.5, "o", "    \u001b[36mremote_port:\u001b[0m 6379\r\n"]
[1.5, "o", "    \u001b[36mlocal_port:\u001b[0m 16379\r\n"]
[2.5, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[3.3, "o", "sshforward config"]
[4.0, "o", "\r\n"]
[4.1, "o", "SERVICE   PORT   REMOTE HOST   REMOTE PORT   LOCAL PORT\r\n"]
[4.1, "o", "mysql     -      127.0.0.1     3306          3306\r\n"]
[4.1, "o", "redis     -      127.0.0.1     6379          16379\r\n"]
[5.5, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[6.5, "o", "sshforward start myserver mysql"]
[7.2, "o", "\r\n"]
[8.5, "o", "Tunnel myserver/mysql started: localhost:3306 -> 127.0.0.1:3306 (PID: 48052)\r\n"]
[9.5, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[10.5, "o", "sshforward list"]
[11.2, "o", "\r\n"]
[11.4, "o", "HOST       SERVICE   PORT   LOCAL PORT   REMOTE           PID     STATUS\r\n"]
[11.4, "o", "myserver   mysql     -      3306         127.0.0.1:3306   48052   active\r\n"]
[13.0, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[14.0, "o", "sshforward stop myserver mysql"]
[14.7, "o", "\r\n"]
[14.9, "o", "Tunnel myserver/mysql stopped\r\n"]
[16.0, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[17.0, "o", ""]
