{"version": 2, "width": 100, "height": 35, "timestamp": 1711500000, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "sshforward — Multi-Port Services"}
[0.0, "o", "\u001b[1;34m$\u001b[0m "]
[0.8, "o", "cat ~/.sshforward/config.yaml"]
[1.4, "o", "\r\n"]
[1.5, "o", "\u001b[33mservices:\u001b[0m\r\n"]
[1.5, "o", "  \u001b[33mgitea:\u001b[0m\r\n"]
[1.5, "o", "    \u001b[36mremote_host:\u001b[0m 127.0.0.1\r\n"]
[1.5, "o", "    \u001b[36mports:\u001b[0m\r\n"]
[1.5, "o", "      - \u001b[36mname:\u001b[0m web\r\n"]
[1.5, "o", "        \u001b[36mremote_port:\u001b[0m 3000\r\n"]
[1.5, "o", "      - \u001b[36mname:\u001b[0m ssh\r\n"]
[1.5, "o", "        \u001b[36mremote_port:\u001b[0m 2222\r\n"]
[3.0, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[4.0, "o", "sshforward start myserver gitea"]
[4.7, "o", "\r\n"]
[6.0, "o", "Tunnel myserver/gitea/web started: localhost:3000 -> 127.0.0.1:3000 (PID: 48052)\r\n"]
[6.1, "o", "Tunnel myserver/gitea/ssh started: localhost:2222 -> 127.0.0.1:2222 (PID: 44048)\r\n"]
[7.5, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[8.5, "o", "sshforward list"]
[9.2, "o", "\r\n"]
[9.4, "o", "HOST       SERVICE   PORT   LOCAL PORT   REMOTE           PID     STATUS\r\n"]
[9.4, "o", "myserver   gitea     web    3000         127.0.0.1:3000   48052   active\r\n"]
[9.4, "o", "myserver   gitea     ssh    2222         127.0.0.1:2222   44048   active\r\n"]
[11.0, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[12.0, "o", "# Connect to Gitea web UI at http://localhost:3000"]
[12.8, "o", "\r\n"]
[13.0, "o", "\u001b[1;34m$\u001b[0m "]
[14.0, "o", "# Clone repos via ssh://git@localhost:2222/user/repo.git"]
[14.8, "o", "\r\n"]
[15.0, "o", "\u001b[1;34m$\u001b[0m "]
[16.5, "o", "sshforward stop myserver gitea"]
[17.2, "o", "\r\n"]
[17.4, "o", "Tunnel myserver/gitea stopped\r\n"]
[18.5, "o", "\r\n\u001b[1;34m$\u001b[0m "]
[19.5, "o", ""]
